@startuml Training_Pipeline
title Training pipeline — ml/train.py

start
:Auto-detect class folders
(data/ layout or "market bought" + "home grinded");
:Load 100 JPGs
50 market_bought + 50 home_ground;
:Stratified split, random_state=42
64 train / 16 val / 20 test;
:tf.data pipeline
resize 224x224, RGB, preprocess_input [-1,1];
:Augmentation inside the model
flip + rotation ±20° + zoom ±0.2
(brightness omitted on purpose);
note right
  Brightness ±0.2 erases the subtle
  mean-colour cue that separates the
  classes, so training collapses to 50%.
  Verified: geometric-only reaches 95%.
end note
:Stage 1 — head only
base frozen, Adam 1e-3, up to 15 epochs;
:Stage 2 — fine-tune
unfreeze last 30 base layers, Adam 1e-5, up to 15 epochs;
:EarlyStopping patience 5
ModelCheckpoint on val_accuracy;
:Evaluate on held-out test
accuracy + confusion matrix + report;
if (test accuracy at least 85%?) then (yes)
  :Save model/turmeric_mobilenet.keras;
  :Mirror to artifacts/ (gitignored);
  :Freeze artifact for inference;
else (no)
  :Inspect augmentation / labels;
  stop
endif
stop

@enduml


