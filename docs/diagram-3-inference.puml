@startuml Inference_Sequence
title Single prediction — request flow

actor User
participant "React UI\n:5173" as UI
participant "FastAPI\n:8001" as API
participant "core/model.py" as Core
database "turmeric_mobilenet\n.keras" as M

User -> UI : upload photo / camera capture
UI -> UI : check type is JPG or PNG
alt wrong type
  UI --> User : "Upload a clear JPG/PNG turmeric powder photo."
else correct type
  UI -> API : POST /predict (multipart)
  API -> API : validate type + decode bytes
  alt unreadable or corrupt
    API --> UI : 400 + error message
    UI --> User : show error, no crash
  else decodable image
    API -> Core : preprocess + quality checks
    Core -> Core : RGB, 224x224, range [-1,1]
    Core -> M : predict (loaded once, cached)
    M --> Core : softmax probabilities
    Core --> API : label, confidence, warnings
    API --> UI : 200 JSON response
    UI -> UI : confidence below 60%?
    UI --> User : label + confidence bar
    note right of UI
      If confidence below 60%, or image
      dark/blurry: show retake guidance and
      never present the label as certain.
    end note
  end
end

@enduml
